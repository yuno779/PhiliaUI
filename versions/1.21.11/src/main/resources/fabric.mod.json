{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "icon": "assets/${mod_id}/icon.png",
  "name": "Philia UI",
  "description": "Philia UI: modernized configuration screens for the masa mod family.",
  "authors": [
    {
      "name": "bunnyi116",
      "contact": {
        "homepage": "https://github.com/bunnyi116"
      }
    }
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_sources}/issues"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.bunnyi116.malilibui.MalilibUiMod"
    ],
    "modmenu": [
      "com.github.bunnyi116.malilibui.compat.MalilibUiModMenu"
    ]
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": [
    "malilib-ui.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "malilib": ">=${malilib}"
  }
}
